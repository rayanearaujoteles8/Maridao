{
  "expo": {
    "name": "Maridão",
    "slug": "mobile-sdk57",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobilesdk57",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "com.anonymous.mobile-sdk57"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#020300",
        "foregroundImage": "./assets/images/android-icon-foreground-maridao.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-maridao.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020300",
          "image": "./assets/images/splash-symbol.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#020300",
            "image": "./assets/images/splash-symbol.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
