{
  "name": "maridao-api",
  "version": "1.0.0",
  "description": "API do aplicativo mobile Maridão",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "db:check": "node --env-file=.env src/check-database.ts",
    "test:compatibility:db": "node --env-file=.env --test tests/catalog-compatibility.database.test.ts",
    "test:progress:db": "node --env-file=.env --test tests/request-progress.database.test.ts",
    "test:unit": "node --test tests/customer.test.ts tests/auth.test.ts tests/provider.test.ts tests/search.test.ts tests/requests.test.ts tests/catalog.test.ts tests/proposals.test.ts tests/request-progress.test.ts tests/proposal-management.test.ts tests/customer-confirmation.test.ts tests/team-workflows.test.ts tests/admin.test.ts tests/request-cancellation.test.ts tests/request-completion.test.ts tests/proposal-versions.test.ts tests/account-deletion.test.ts tests/notifications.test.ts tests/mail.test.ts tests/profile-photo.test.ts",
    "test:proposals:db": "node --env-file=.env --test tests/proposal-management.database.test.ts",
    "mail:configure": "node --env-file-if-exists=.env src/configure-mail.ts",
    "db:workflows": "node --env-file=.env src/check-workflows.ts",
    "test:notifications:db": "node --env-file=.env --test tests/notification-delivery.database.test.ts",
    "db:activate": "node --env-file=.env src/activate-database.ts",
    "test:team:db": "node --env-file=.env --test tests/team-workflows.database.test.ts",
    "test:admin:db": "node --env-file=.env --test tests/admin.database.test.ts",
    "test:cancel:db": "node --env-file=.env --test tests/request-cancellation.database.test.ts",
    "test:completion:db": "node --env-file=.env --test tests/request-completion.database.test.ts",
    "test:versions:db": "node --env-file=.env --test tests/proposal-versions.database.test.ts",
    "test:deletion:db": "node --env-file=.env --test tests/account-deletion.database.test.ts",
    "requests:auto-confirm": "node --env-file=.env src/auto-confirm.ts",
    "proposals:expire": "node --env-file=.env src/expire-proposals.ts",
    "admin:create": "node --env-file=.env src/create-admin.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "private": true
}
